# 流年小账 · 后端环境变量模板（复制为 .env 填入真实值，.env 已被 gitignore）
# 复制本文件为 ci/.env 后修改右侧取值即可

# ---- MySQL（远端部署）----
MYSQL_HOST=xxxx
MYSQL_PORT=xxxx
MYSQL_USER=xxxx
MYSQL_PASSWORD=xxxx
# ⚠️ 开发环境固定为 liunian_account_dev，禁止填 liunian_account（生产库，已有真实用户）。
#    启动时 DatabaseGuard 会校验实际库名，不一致直接拒绝启动。
MYSQL_DB=liunian_account_dev
# 仅生产部署才设为 true，且必须同时把 MYSQL_DB 设为 liunian_account
DB_ALLOW_PROD=false

# ---- Redis（远端部署）----
REDIS_HOST=xxxx
REDIS_PORT=6479
REDIS_PASSWORD=xxxx
# 开发环境建议使用独立 DB（如 1），避免与生产共用 0 号库导致会话/锁互相干扰
REDIS_DB=1

# ---- 微信小程序 ----
WX_APPID=xxxx
WX_SECRET=请替换为真实 AppSecret
WX_MOCK=true
WX_INVITE_PAGE=pages/invite/invite
WX_MSG_TMPL_ID=

# ---- 服务与鉴权 ----
SERVER_PORT=8445
JWT_SECRET=xxxx
