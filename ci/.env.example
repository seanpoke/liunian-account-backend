
# -- 是否为生产环境
DB_ALLOW_PROD=false

# ----docker相关---
SERVER_PORT=8666
CONTAINER_NAME=liunian-account-backend

# ---- MySQL（远端部署）----
MYSQL_HOST=xxx
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DB=liunian_account

# ---- Redis（远端部署）----
REDIS_HOST=xxx
REDIS_PORT=6479
REDIS_PASSWORD=xxx
REDIS_DB=0

# ---- 微信小程序 ----
WX_APPID=xxx
WX_SECRET=xxx
WX_MOCK=false
WX_INVITE_PAGE=pages/invite/invite
WX_MSG_TMPL_ID=
# 小程序码 env_version：本地开发者工具用 develop，体验版 trial，已发布线上用 release
WX_ENV_VERSION=develop

# ---- 服务与鉴权(32位随机) ----
JWT_SECRET=xxx

