# 流年小账 · 后端环境变量模板（复制为 .env 填入真实值，.env 已被 gitignore）
# 复制本文件为 ci/.env 后修改右侧取值即可

# ---- MySQL（远端部署）----
MYSQL_HOST=xxxx
MYSQL_PORT=xxxx
MYSQL_USER=xxxx
MYSQL_PASSWORD=xxxx
MYSQL_DB=liunian_account

# ---- Redis（远端部署）----
REDIS_HOST=xxxx
REDIS_PORT=6479
REDIS_PASSWORD=xxxx
REDIS_DB=0

# ---- 微信小程序 ----
WX_APPID=xxxx
WX_SECRET=请替换为真实 AppSecret
WX_MOCK=true
WX_INVITE_PAGE=pages/invite/invite
WX_MSG_TMPL_ID=

# ---- 服务与鉴权 ----
SERVER_PORT=8445
JWT_SECRET=xxxx
